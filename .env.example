# Database
DATABASE_URL=postgresql://speakai:speakai_secret@localhost:5432/speakai

# NextAuth
AUTH_SECRET=change-me-to-a-random-string
AUTH_URL=http://localhost:3000

# Google OAuth
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# TTS (Azure Speech) — add up to N endpoints; chunks are round-robin across all
AZURE_SPEECH_KEY_1=your-azure-speech-key
AZURE_SPEECH_REGION_1=eastus
# AZURE_SPEECH_KEY_2=your-second-azure-speech-key
# AZURE_SPEECH_REGION_2=westus
# AZURE_SPEECH_KEY_3=your-third-azure-speech-key
# AZURE_SPEECH_REGION_3=eastus2
# AZURE_SPEECH_KEY_4=your-fourth-azure-speech-key
# AZURE_SPEECH_REGION_4=southeastasia
# AZURE_SPEECH_KEY_5=your-fifth-azure-speech-key
# AZURE_SPEECH_REGION_5=westeurope
# Optional: override default Azure voices for UI labels
# AZURE_SPEECH_VOICE_FEMALE_1=en-US-JennyNeural
# AZURE_SPEECH_VOICE_MALE_1=en-US-GuyNeural
# AZURE_SPEECH_PRICE_USD_PER_1M_CHARS=16

# OpenAI-compatible fallback for Vision if VISION_* is not configured
TTS_API_KEY=your-openai-compatible-api-key
TTS_BASE_URL=https://api.openai.com/v1

# Vision (for image OCR)
VISION_API_KEY=your-vision-api-key
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4.1-mini
# Vision pricing per 1M tokens in USD (defaults: gpt-4.1-mini rates)
# VISION_PRICE_INPUT_PER_1M_TOKENS=0.40
# VISION_PRICE_OUTPUT_PER_1M_TOKENS=1.60

# AI Pronunciation Feedback (falls back to VISION_* then TTS_* if unset)
# FEEDBACK_API_KEY=your-feedback-api-key
# FEEDBACK_BASE_URL=https://api.openai.com/v1
# FEEDBACK_MODEL=gpt-4.1-mini
# FEEDBACK_PRICE_INPUT_PER_1M_TOKENS=0.40
# FEEDBACK_PRICE_OUTPUT_PER_1M_TOKENS=1.60

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Credits
WELCOME_CREDITS=3

# Credit Plans
STRIPE_PLAN_A_CREDITS=15
STRIPE_PLAN_A_PRICE_HKD=15
STRIPE_PLAN_B_CREDITS=50
STRIPE_PLAN_B_PRICE_HKD=45

# Audio retention (days before auto-deletion, default 365)
AUDIO_RETENTION_DAYS=365
# Recording retention (days, defaults to AUDIO_RETENTION_DAYS)
# RECORDING_RETENTION_DAYS=365

# Assessment pricing (USD per hour of audio, default 1.00)
# ASSESSMENT_PRICE_USD_PER_HOUR=1.00

# Admin (comma-separated email addresses)
ADMIN_EMAIL=admin@example.com
